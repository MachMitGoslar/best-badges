    "@best-badges/badge-spec": "workspace:*",
    "@best-badges/design-tokens": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/react": "~19.3.0",
    "expo": "~58.0.25",
    "expo-auth-session": "~58.0.18",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-gl": "~58.0.4",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
