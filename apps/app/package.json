{
  "name": "@best-badges/app",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "web3d": "pnpm --filter @best-badges/badge-3d build:webview",
    "start": "pnpm web3d && expo start --dev-client",
    "ios": "pnpm web3d && expo run:ios",
    "typecheck": "pnpm web3d && tsc --noEmit"
  },
  "dependencies": {
    "@best-badges/api-client": "workspace:*",
