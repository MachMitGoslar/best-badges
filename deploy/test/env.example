# /srv/stacks/badges/.env – trägt stuff selbst ein (nicht ins Repository)
# Passwort des Datenbank-Benutzers best_badges, z. B. erzeugt mit: openssl rand -base64 32 | tr -d '/+='
BADGES_DB_PASSWORD=

# Push über Apple (optional). Schlüssel-Datei nach secrets/apns.p8 kopieren (Rechte 600), dann:
# APNS_KEY_FILE=/run/badges-secrets/apns.p8
# APNS_KEY_ID=          (10 Zeichen, aus dem Apple-Entwicklerkonto)
# APNS_TEAM_ID=JPNPSJ256T
# APNS_TOPIC=de.machmitgoslar.bestbadges.dev
